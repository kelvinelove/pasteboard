{
	"name": "pasteboard",
	"displayName": "Pasteboard",
	"description": "Quick notes and a persistent scratchpad for VS Code, with autosave, workspace and global notes, search, and quick capture.",
	"publisher": "kelvinelove",
	"author": "kelvinelove",
	"license": "MIT",
	"version": "0.5.5",
	"icon": "media/icon.png",
	"engines": {
		"vscode": "^1.74.0"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"pasteboard",
		"notes",
		"note taking",
		"notepad",
		"scratchpad",
		"quick notes",
		"persistent notes",
		"workspace notes",
		"global notes",
		"autosave",
		"quick capture",
		"clipboard notes",
		"text snippets",
		"editor notes",
		"developer productivity",
		"productivity",
		"vscode notes",
		"visual studio code"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/kelvinelove/pasteboard"
	},
	"homepage": "https://github.com/kelvinelove/pasteboard#readme",
	"bugs": {
		"url": "https://github.com/kelvinelove/pasteboard/issues"
	},
	"activationEvents": [
		"onStartupFinished",
		"onView:pasteboard.view",
		"onWebviewPanel:pasteboard.panel",
		"onCommand:pasteboard.toggle-sidebar",
		"onCommand:pasteboard.toggleFromStatusBar",
		"onCommand:pasteboard.togglePanel",
		"onCommand:pasteboard.open",
		"onCommand:pasteboard.toggle-panel-position",
		"onCommand:pasteboard.new-item",
		"onCommand:pasteboard.save-item",
		"onCommand:pasteboard.delete-item",
		"onCommand:pasteboard.open-global",
		"onCommand:pasteboard.openGlobalTab",
		"onCommand:pasteboard.setDefaultPlacement",
		"onCommand:pasteboard.addSelectionToPasteboard",
		"onCommand:pasteboard.newFromClipboard",
		"onCommand:pasteboard.quickOpen",
		"onCommand:pasteboard.exportTabToMarkdown"
	],
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src",
		"package": "vsce package --no-dependencies"
	},
	"devDependencies": {
		"@types/node": "20.x",
		"@types/vscode": "^1.74.0",
		"@typescript-eslint/eslint-plugin": "^8.25.0",
		"@typescript-eslint/parser": "^8.25.0",
		"@vscode/vsce": "^3.2.1",
		"eslint": "^9.21.0",
		"typescript": "^5.7.3"
	},
	"contributes": {
		"commands": [
			{
				"command": "pasteboard.toggle-sidebar",
				"title": "Pasteboard: Toggle Sidebar",
				"category": "Pasteboard",
				"icon": "$(clipboard)"
			},
			{
				"command": "pasteboard.toggleFromStatusBar",
				"title": "Pasteboard: Toggle from Status Bar",
				"category": "Pasteboard"
			},
			{
				"command": "pasteboard.togglePanel",
				"title": "Pasteboard: Toggle Panel",
				"category": "Pasteboard"
			},
			{
				"command": "pasteboard.open",
				"title": "Pasteboard: Open",
				"category": "Pasteboard",
				"icon": "$(notebook)"
			},
			{
				"command": "pasteboard.toggle-panel-position",
				"title": "Pasteboard: Toggle Panel View",
				"category": "Pasteboard",
				"icon": "$(layout-panel)"
			},
			{
				"command": "pasteboard.new-item",
				"title": "Pasteboard: New Item",
				"category": "Pasteboard",
				"icon": "$(add)"
			},
			{
				"command": "pasteboard.save-item",
				"title": "Pasteboard: Save Item",
				"category": "Pasteboard",
				"icon": "$(save)"
			},
			{
				"command": "pasteboard.delete-item",
				"title": "Pasteboard: Delete Item",
				"category": "Pasteboard",
				"icon": "$(trash)"
			},
			{
				"command": "pasteboard.open-global",
				"title": "Pasteboard: Open Global Tab",
				"category": "Pasteboard",
				"icon": "$(globe)"
			},
			{
				"command": "pasteboard.openGlobalTab",
				"title": "Pasteboard: Open Global Tab",
				"category": "Pasteboard"
			},
			{
				"command": "pasteboard.setDefaultPlacement",
				"title": "Pasteboard: Set Default Placement",
				"category": "Pasteboard"
			},
			{
				"command": "pasteboard.addSelectionToPasteboard",
				"title": "Pasteboard: Add Selection to Pasteboard",
				"category": "Pasteboard",
				"icon": "$(add)"
			},
			{
				"command": "pasteboard.newFromClipboard",
				"title": "Pasteboard: New Item from Clipboard",
				"category": "Pasteboard"
			},
			{
				"command": "pasteboard.quickOpen",
				"title": "Pasteboard: Quick Open Item",
				"category": "Pasteboard",
				"icon": "$(search)"
			},
			{
				"command": "pasteboard.exportTabToMarkdown",
				"title": "Pasteboard: Export Current Tab to Markdown",
				"category": "Pasteboard"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "pasteboard-container",
					"title": "Pasteboard",
					"icon": "media/icons/light.svg"
				}
			]
		},
		"views": {
			"pasteboard-container": [
				{
					"id": "pasteboard.view",
					"type": "webview",
					"name": "Pasteboard",
					"icon": "media/icons/light.svg"
				}
			]
		},
		"menus": {
			"view/title": [
				{
					"command": "pasteboard.toggle-panel-position",
					"group": "navigation@1",
					"when": "view == pasteboard.view"
				},
				{
					"command": "pasteboard.new-item",
					"group": "navigation@2",
					"when": "view == pasteboard.view"
				}
			],
			"editor/title": [
				{
					"command": "pasteboard.toggle-panel-position",
					"group": "navigation@1",
					"when": "activeWebviewPanelId == pasteboard.panel"
				},
				{
					"command": "pasteboard.new-item",
					"group": "navigation@2",
					"when": "activeWebviewPanelId == pasteboard.panel"
				}
			],
			"editor/context": [
				{
					"command": "pasteboard.addSelectionToPasteboard",
					"group": "z_pasteboard",
					"when": "editorHasSelection"
				}
			]
		},
		"configuration": {
			"title": "Pasteboard",
			"properties": {
				"pasteboard.autosave": {
					"type": "boolean",
					"default": true,
					"description": "Automatically save the current note after idle typing."
				},
				"pasteboard.autosaveDelay": {
					"type": "number",
					"default": 1000,
					"minimum": 250,
					"maximum": 10000,
					"description": "Idle delay in milliseconds before autosave runs. Clamped to 250-10000."
				},
				"pasteboard.confirmDelete": {
					"type": "boolean",
					"default": true,
					"description": "Require confirmation before deleting an item."
				},
				"pasteboard.maxItems": {
					"type": "number",
					"default": 200,
					"minimum": 1,
					"description": "Maximum items kept per tab. Oldest non-pinned items are pruned when exceeded."
				},
				"pasteboard.editorBorder": {
					"type": [
						"string",
						"boolean"
					],
					"default": "1px",
					"description": "Border around the editor area. Set to false to disable, or a CSS width like \"2px\"."
				},
				"pasteboard.preferredWidthPercent": {
					"type": "number",
					"default": 25,
					"minimum": 10,
					"maximum": 50,
					"description": "Preferred compact width percentage for the panel fallback when the editor is split beside the main editor."
				},
				"pasteboard.sidebarMode": {
					"type": "string",
					"enum": [
						"view",
						"beside"
					],
					"default": "view",
					"description": "How the Status Bar toggle opens Pasteboard. \"view\" uses the sidebar WebviewView. \"beside\" opens a WebviewPanel beside the editor."
				},
				"pasteboard.openPanelOnStartup": {
					"type": "boolean",
					"default": false,
					"description": "Open the Pasteboard panel view when VS Code starts."
				},
				"pasteboard.storageMode": {
					"type": "string",
					"enum": [
						"state",
						"file"
					],
					"enumDescriptions": [
						"Store per-workspace items in VS Code's workspaceState (default).",
						"Store per-workspace items in a .vscode/pasteboard.json file in each workspace folder, so notes sync across editors/IDEs that open the same folder. The GLOBAL tab always stays in globalState."
					],
					"default": "state",
					"description": "Where per-workspace Pasteboard items are persisted."
				}
			}
		},
		"keybindings": [
			{
				"command": "pasteboard.toggleFromStatusBar",
				"key": "ctrl+alt+p",
				"mac": "cmd+alt+p"
			},
			{
				"command": "pasteboard.save-item",
				"key": "ctrl+alt+s",
				"mac": "cmd+alt+s",
				"when": "pasteboardFocused"
			},
			{
				"command": "pasteboard.new-item",
				"key": "ctrl+alt+n",
				"mac": "cmd+alt+n",
				"when": "pasteboardFocused"
			},
			{
				"command": "pasteboard.addSelectionToPasteboard",
				"key": "ctrl+alt+shift+p",
				"mac": "cmd+alt+shift+p",
				"when": "editorTextFocus && editorHasSelection"
			},
			{
				"command": "pasteboard.quickOpen",
				"key": "ctrl+alt+o",
				"mac": "cmd+alt+o"
			}
		]
	}
}
